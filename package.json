{
  "name": "bada-english-platform",
  "version": "1.0.0",
  "description": "BADA 영어 - 4주 완성 수준별 영어 원서 읽기 & 스피킹 웹 서비스 (아기 고래 포포와 함께하는 바다 탐험)",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "node --no-warnings scripts/init-postgres.js"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "pg": "^8.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

# ============================================================================
# BADA English 환경변수 설정 파일 (.env)
# ============================================================================

# 서버 포트
PORT=3000
HOST=0.0.0.0

# 1) 로컬 PostgreSQL 사용 시 (설치하신 PostgreSQL 비밀번호로 변경하세요)
USE_POSTGRES=true
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bada_english

# 2) 또는 단일 URL 방식 (클라우드 배포 시 Supabase / Neon / Railway PostgreSQL URL 입력)
# DATABASE_URL=postgresql://postgres:비밀번호@localhost:5432/bada_english

